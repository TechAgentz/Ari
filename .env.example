# ─────────────────────────────────────────────────────────────
# Haven demo — environment configuration
# Copy to .env.local and fill in. Everything is optional:
# without a key the app runs in scripted "demo" mode.
# ─────────────────────────────────────────────────────────────

# Which AI provider powers conversations: "groq" or "demo".
# Defaults to "groq" when GROQ_API_KEY is set, otherwise "demo".
AI_PROVIDER=groq

# Server-side only. Never prefix with NEXT_PUBLIC_.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Chat model (Groq production models as of Nov 2026: openai/gpt-oss-120b, openai/gpt-oss-20b).
GROQ_MODEL=openai/gpt-oss-120b

# Optional: a faster model for voice conversations (defaults to GROQ_MODEL).
# GROQ_VOICE_MODEL=openai/gpt-oss-20b

# If the model is rate-limited (free tier: ~8k tokens/min per model), retry once on this model.
# Defaults to the other gpt-oss model; set to "none" to go straight to the scripted fallback.
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Speech-to-text fallback (used when the browser has no built-in speech recognition).
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional server text-to-speech (Groq preview model). Leave empty to use the browser's voices.
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=hannah

# Abort a Groq request (and fall back to demo mode) after this many milliseconds.
GROQ_TIMEOUT_MS=20000
